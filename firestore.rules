rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email == "clarrysoncarson003@gmail.com") ||
          (request.auth.token.isDevAdmin == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Voters: Only admins can manage, users can read their own (if we had a user-to-voter mapping)
    // For this app, we'll allow public read of candidates and config, but restricted write.
    match /voters/{voterId} {
      allow read: if true; // Allow backend to check registration
      // Only allow updating the hasVoted flag from false to true
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted']) && 
                       request.resource.data.hasVoted == true &&
                       resource.data.hasVoted == false;
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if true; // Publicly readable for the dashboard
      // Only allow incrementing the vote count by exactly 1
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']) && 
                       request.resource.data.voteCount == resource.data.voteCount + 1;
      allow write: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if true; // Publicly readable for the live activity feed
      // Only allow creating a valid vote with strict structure
      allow create: if request.resource.data.keys().hasAll(['candidateId', 'faculty', 'timestamp']) &&
                       request.resource.data.size() == 3;
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /voting_history/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}

{
  "entities": {
    "Voter": {
      "title": "Voter",
      "description": "An eligible student voter.",
      "type": "object",
      "properties": {
        "admissionNumber": { "type": "string", "description": "Unique student admission number." },
        "email": { "type": "string", "format": "email", "description": "University student email." },
        "hasVoted": { "type": "boolean", "description": "Flag to prevent multiple voting." },
        "faculty": { "type": "string", "description": "The faculty the student belongs to." }
      },
      "required": ["admissionNumber", "email", "hasVoted", "faculty"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "A candidate running for a guild position.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Candidate's full name." },
        "faculty": { "type": "string", "description": "Candidate's faculty." },
        "role": { "type": "string", "description": "The position the candidate is vying for (e.g., Chairperson, Sec.General)." },
        "voteCount": { "type": "integer", "description": "Total number of votes received." },
        "imageUrl": { "type": "string", "format": "uri", "description": "Profile image URL." },
        "bio": { "type": "string", "description": "Brief candidate biography." },
        "manifesto": { "type": "string", "description": "Manifesto summary." }
      },
      "required": ["name", "faculty", "role", "voteCount"]
    },
    "Vote": {
      "title": "Vote",
      "description": "An anonymous ballot.",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string", "description": "ID of the candidate voted for." },
        "faculty": { "type": "string", "description": "Faculty of the voter (for analytics)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the vote was cast." }
      },
      "required": ["candidateId", "faculty", "timestamp"]
    },
    "ElectionConfig": {
      "title": "ElectionConfig",
      "description": "Configuration for the election lifecycle.",
      "type": "object",
      "properties": {
        "electionName": { "type": "string", "description": "The title of the election." },
        "bannerUrl": { "type": "string", "description": "URL for the election banner or logo." },
        "openingTime": { "type": "string", "format": "date-time", "description": "When voting starts." },
        "closingTime": { "type": "string", "format": "date-time", "description": "When voting ends." },
        "status": { "type": "string", "enum": ["upcoming", "live", "paused", "ended"], "description": "Current election status." }
      },
      "required": ["electionName", "openingTime", "closingTime", "status"]
    }
  },
  "firestore": {
    "voters": { "schema": "Voter", "description": "Collection of eligible voters." },
    "candidates": { "schema": "Candidate", "description": "Collection of candidates." },
    "votes": { "schema": "Vote", "description": "Collection of anonymous ballots." },
    "config": { "schema": "ElectionConfig", "description": "Election settings." },
    "voting_history": { "schema": "object", "description": "Archived election results." }
  }
}
